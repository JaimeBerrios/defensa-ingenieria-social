\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{../plantilla/latex/unab_reporte}[2026/09/07 Plantilla institucional de reportes]
\RequirePackage[margin=2.5cm,includefoot,headheight=16pt]{geometry}
\RequirePackage{graphicx}
\RequirePackage{xcolor}
\RequirePackage{fontspec}
\RequirePackage{needspace}
\newfontfamily\FuenteFirma[Path=../assets/fuentes/]{firma.otf}
\RequirePackage{microtype}
\RequirePackage{setspace}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{colortbl}
\RequirePackage{enumitem}
\RequirePackage{hyperref}
\RequirePackage{listings}
\definecolor{unabblue}{HTML}{173864}
\definecolor{softgray}{HTML}{F2F2F2}
\definecolor{linegray}{HTML}{D8DEE8}
\definecolor{codegreen}{HTML}{2E7D32}
\definecolor{codegray}{HTML}{6E7781}
\definecolor{codepurple}{HTML}{7B1FA2}
\definecolor{codebg}{HTML}{F6F8FA}

\lstdefinestyle{unabcode}{
  backgroundcolor=\color{codebg},
  commentstyle=\color{codegreen}\itshape,
  keywordstyle=\color{unabblue}\bfseries,
  numberstyle=\tiny\color{codegray},
  stringstyle=\color{codepurple},
  basicstyle=\ttfamily\footnotesize,
  breakatwhitespace=false,
  breaklines=true,
  captionpos=b,
  keepspaces=true,
  numbers=left,
  numbersep=8pt,
  showspaces=false,
  showstringspaces=false,
  showtabs=false,
  tabsize=2,
  frame=single,
  framerule=0.5pt,
  rulecolor=\color{linegray}
}
\lstset{style=unabcode}

% Entorno institucional para notas y observaciones
\newenvironment{cajanota}[1][Nota informativa]{%
  \par\vspace{0.3cm}
  \noindent
  \begin{tabularx}{\textwidth}{@{}|X|@{}}
    \hline
    \cellcolor{softgray}\textbf{\color{unabblue}#1}\par\vspace{0.15cm}
}{%
    \\ \hline
  \end{tabularx}
  \par\vspace{0.3cm}
}
\hypersetup{colorlinks=true,linkcolor=unabblue,urlcolor=unabblue,citecolor=unabblue}
\onehalfspacing
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6em}
\setlength{\emergencystretch}{2em}
\setlist[itemize]{topsep=0.3em,itemsep=0.2em}
\titleformat{\section}{\Large\sffamily\bfseries\color{unabblue}}{\thesection.}{0.6em}{}
\titleformat{\subsection}{\large\sffamily\bfseries\color{unabblue}}{\thesubsection}{0.6em}{}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\sffamily\color{unabblue}\TituloCorto}
\fancyfoot[C]{\small\sffamily\color{unabblue}Reporte académico\hfill\thepage}
\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\footrulewidth}{0pt}
\newcommand{\logoreporte}[2]{%
  \includegraphics[width=#2,height=2cm,keepaspectratio]{#1}%
}
\newcommand{\portadareporte}{%
  \hypersetup{pageanchor=false}
  \begin{titlepage}
  \singlespacing
  \logoreporte{../assets/institucional/isotipo-azul.png}{2.7cm}\hfill
  \logoreporte{../assets/institucional/logo-facultad.png}{2.7cm}
  \begin{center}
    \vspace{0.6cm plus 0.4cm minus 0.2cm}
    {\large\sffamily\bfseries\color{unabblue}\Institucion\par}
    \vspace{0.2cm}
    {\sffamily\Facultad\par}
    \vfill
    {\small\sffamily\color{unabblue}REPORTE ACADÉMICO\par}
    \vspace{0.3cm plus 0.2cm minus 0.1cm}
    {\fontsize{22}{28}\selectfont\sffamily\bfseries\color{unabblue}\TituloTrabajo\par}
    \vspace{0.25cm plus 0.15cm minus 0.1cm}
    {\large\SubtituloTrabajo\par}
    \vspace{0.3cm plus 0.2cm minus 0.1cm}
    {\color{unabblue}\rule{0.35\textwidth}{1.2pt}\par}
    \vfill
  \end{center}
  \textbf{Asignatura:} \Asignatura\par
  \textbf{Docente:} \Docente\par
  \textbf{Grupo:} \Grupo\par
  \vspace{0.3cm plus 0.1cm minus 0.1cm}
  \textbf{Integrantes}\par
  {\small
  \begin{tabularx}{\textwidth}{@{}Xl@{}}
    \toprule
    \textbf{Nombre completo} & \textbf{Código} \\
    \midrule
    \Integrantes
    \bottomrule
  \end{tabularx}}
  \vfill
  \begin{center}
    \small\LugarFecha\par
    \vspace{0.3cm plus 0.2cm minus 0.1cm}
    \includegraphics[height=2.0cm,keepaspectratio]{../assets/institucional/acreditacion.png}
  \end{center}
  \end{titlepage}
  \hypersetup{pageanchor=true}
}


% Firma tipográfica personal; se imprime solo al final del reporte.
\newcommand{\firmareporte}{%
  \par\Needspace{4cm}
  \vspace{1cm}
  \begin{flushright}
    {\color{unabblue}\FuenteFirma\fontsize{34}{42}\selectfont\NombreFirma\par}
    \vspace{0.2cm}
    {\color{linegray}\rule{5.3cm}{0.5pt}\par}
    {\small\sffamily\color{unabblue}\NombreFirma\par}
    {\footnotesize\sffamily Elaboración del documento\par}
  \end{flushright}
}
